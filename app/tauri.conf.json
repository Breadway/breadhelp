{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOS Help",
  "version": "0.3.0",
  "identifier": "com.breadway.breadhelp",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOS Help",
        "width": 1040,
        "height": 680,
        "minWidth": 560,
        "minHeight": 480,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0c0c0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
